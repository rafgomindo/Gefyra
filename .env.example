# Copy to .env for local script runs (the MCP server itself reads these from
# the env block in your AI client's config, e.g. claude_desktop_config.json).
# Never commit a filled-in .env — it's already in .gitignore.

ZOTERO_USER_ID=
ZOTERO_API_KEY=

# Optional overrides, only needed for non-default setups:
# ZOTERO_LOCAL_URL=http://localhost:23119
# ZOTERO_CLOUD_URL=https://api.zotero.org

# Point Gefyra at a Zotero group library instead of your personal library.
# ZOTERO_LIBRARY_TYPE=group
# ZOTERO_LIBRARY_ID=          # the group ID, not your user ID

# Disable every write tool (create/update/trash/tag/fuse/associate/upload).
# Read/search tools keep working. Useful when handing Gefyra to an AI agent
# you don't fully trust yet with a live research library.
# GEFYRA_READ_ONLY=true
